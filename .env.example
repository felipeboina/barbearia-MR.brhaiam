# Painel do Supabase > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# "Publishable key" no painel novo do Supabase (equivalente à antiga "anon key")
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
# "Secret key" no painel novo (equivalente à antiga "service_role key") — bypassa RLS, nunca expor no client
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx

# Domínio raiz usado para resolver subdomínios (tenants).
# Em desenvolvimento local, deixe como está — "joao.localhost:3000" já
# funciona no navegador sem precisar mexer no /etc/hosts.
# Em produção, use o domínio que você registrou, ex: meudominio.com.br
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
